{
  "compilerOptions": {
    "rootDir": "./",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "nodenext",
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "noEmit": false,
    "outDir": "build",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "./src/**/*.ts"
  ]
}
